APP_NAME=AI Document Intelligence API
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://document_user:document_password@localhost:5432/document_platform

JWT_SECRET_KEY=replace_with_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=10

OPENAI_API_KEY=your_openai_api_key